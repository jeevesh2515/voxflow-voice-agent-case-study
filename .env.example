# The synthetic demo needs no environment variables.
#
# This file exists so the public case study has an audited example without
# exposing deployment configuration. The private service uses a managed secret
# store; names below are generic placeholders only. Never commit values.
#
# The demo ignores this file.

VOXFLOW_API_URL=
VOXFLOW_SECRET=
CONNECT_REGION=eu-west-2
